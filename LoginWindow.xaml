<Window x:Class="ProjectOpti.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Project Opti - Login" Width="900" Height="620"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#1E1433" Offset="0" />
                <GradientStop Color="#0E1016" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <!-- falling icons (behind everything) -->
            <Canvas x:Name="IconCanvas" ClipToBounds="True" IsHitTestVisible="False" />

            <!-- shown only if the icons folder is empty / missing -->
            <TextBlock x:Name="NoIconsText" Visibility="Collapsed" VerticalAlignment="Bottom"
                       HorizontalAlignment="Center" Margin="0,0,0,12" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" />

            <!-- login card -->
            <Border x:Name="LoginCard" Style="{StaticResource Card}" Width="380" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="28" Background="#F0171A22" BorderBrush="#44A855F7">
                <StackPanel>
                    <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,0,14">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Project Opti" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Sign in to continue" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,24" />

                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="2,0,0,6" />
                    <TextBox x:Name="UserBox" Style="{StaticResource InputBox}" />

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="2,16,0,6" />
                    <PasswordBox x:Name="PassBox" Style="{StaticResource InputPassword}" />

                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}"
                               FontSize="12.5" Margin="2,12,0,0" />

                    <Button x:Name="LoginButton" Content="Log in" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Stretch" Click="LoginButton_Click" />
                </StackPanel>
            </Border>

            <!-- minimize / close -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinButton_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
